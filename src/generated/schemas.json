{
  "Concept": {
    "$defs": {
      "Depth": {
        "enum": [
          "foundation",
          "intermediate",
          "advanced"
        ],
        "title": "Depth",
        "type": "string"
      },
      "RelationKind": {
        "enum": [
          "requires",
          "uses",
          "demonstrated_by",
          "evidenced_by",
          "assessed_against",
          "supersedes"
        ],
        "title": "RelationKind",
        "type": "string"
      },
      "Relationship": {
        "description": "A typed edge in the learning graph.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/RelationKind"
          },
          "target": {
            "description": "Stable id of the related object.",
            "title": "Target",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Note"
          }
        },
        "required": [
          "kind",
          "target"
        ],
        "title": "Relationship",
        "type": "object"
      },
      "Stack": {
        "enum": [
          "html",
          "css",
          "bootstrap",
          "php",
          "mysql",
          "javascript",
          "architecture"
        ],
        "title": "Stack",
        "type": "string"
      }
    },
    "properties": {
      "id": {
        "description": "Stable slug, e.g. 'crud'.",
        "title": "Id",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "stack": {
        "$ref": "#/$defs/Stack"
      },
      "depth": {
        "$ref": "#/$defs/Depth"
      },
      "summary": {
        "title": "Summary",
        "type": "string"
      },
      "vocabulary": {
        "items": {
          "type": "string"
        },
        "title": "Vocabulary",
        "type": "array"
      },
      "common_errors": {
        "items": {
          "type": "string"
        },
        "title": "Common Errors",
        "type": "array"
      },
      "code_example": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Code Example"
      },
      "relationships": {
        "items": {
          "$ref": "#/$defs/Relationship"
        },
        "title": "Relationships",
        "type": "array"
      },
      "wjec_reference": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "WJEC Unit 4 specification reference.",
        "title": "Wjec Reference"
      }
    },
    "required": [
      "id",
      "title",
      "stack",
      "depth",
      "summary"
    ],
    "title": "Concept",
    "type": "object"
  },
  "Skill": {
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "concept_ids": {
        "items": {
          "type": "string"
        },
        "title": "Concept Ids",
        "type": "array"
      },
      "observable_behaviour": {
        "description": "What the learner can be seen doing when they hold this skill.",
        "title": "Observable Behaviour",
        "type": "string"
      }
    },
    "required": [
      "id",
      "title",
      "observable_behaviour"
    ],
    "title": "Skill",
    "type": "object"
  },
  "Task": {
    "$defs": {
      "PedagogyMode": {
        "description": "Gradual release of responsibility.",
        "enum": [
          "i_do",
          "we_do",
          "you_do"
        ],
        "title": "PedagogyMode",
        "type": "string"
      }
    },
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "prompt": {
        "title": "Prompt",
        "type": "string"
      },
      "concept_ids": {
        "items": {
          "type": "string"
        },
        "title": "Concept Ids",
        "type": "array"
      },
      "difficulty": {
        "description": "1 (recall) to 5 (transfer).",
        "title": "Difficulty",
        "type": "integer"
      },
      "mode": {
        "$ref": "#/$defs/PedagogyMode"
      },
      "success_criteria": {
        "items": {
          "type": "string"
        },
        "title": "Success Criteria",
        "type": "array"
      }
    },
    "required": [
      "id",
      "title",
      "prompt",
      "difficulty",
      "mode"
    ],
    "title": "Task",
    "type": "object"
  },
  "Intent": {
    "$defs": {
      "PedagogyMode": {
        "description": "Gradual release of responsibility.",
        "enum": [
          "i_do",
          "we_do",
          "you_do"
        ],
        "title": "PedagogyMode",
        "type": "string"
      }
    },
    "description": "The parsed shape of anything a learner asks, from any surface.",
    "properties": {
      "verb": {
        "description": "explain | build | inspect | assess | trace | compare",
        "title": "Verb",
        "type": "string"
      },
      "subject": {
        "description": "Concept, ADR, artefact or file id.",
        "title": "Subject",
        "type": "string"
      },
      "mode": {
        "$ref": "#/$defs/PedagogyMode",
        "default": "we_do"
      },
      "surface": {
        "default": "chat",
        "description": "chat | voice | swagger | mcp | pde",
        "title": "Surface",
        "type": "string"
      },
      "raw": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Raw"
      }
    },
    "required": [
      "verb",
      "subject"
    ],
    "title": "Intent",
    "type": "object"
  },
  "Evidence": {
    "$defs": {
      "EvidenceKind": {
        "enum": [
          "code",
          "schema",
          "test",
          "explanation",
          "artefact",
          "interaction"
        ],
        "title": "EvidenceKind",
        "type": "string"
      }
    },
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "$ref": "#/$defs/EvidenceKind"
      },
      "concept_ids": {
        "items": {
          "type": "string"
        },
        "title": "Concept Ids",
        "type": "array"
      },
      "decision_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Decision Id"
      },
      "body": {
        "title": "Body",
        "type": "string"
      },
      "created_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Created At"
      }
    },
    "required": [
      "id",
      "kind",
      "body"
    ],
    "title": "Evidence",
    "type": "object"
  },
  "Decision": {
    "$defs": {
      "DecisionStatus": {
        "enum": [
          "proposed",
          "accepted",
          "superseded"
        ],
        "title": "DecisionStatus",
        "type": "string"
      },
      "DecisionType": {
        "enum": [
          "data_architecture",
          "interface_design",
          "algorithm",
          "security",
          "planning",
          "testing"
        ],
        "title": "DecisionType",
        "type": "string"
      },
      "Depth": {
        "enum": [
          "foundation",
          "intermediate",
          "advanced"
        ],
        "title": "Depth",
        "type": "string"
      }
    },
    "description": "An Architectural Decision Record, authored by or with the learner.",
    "properties": {
      "id": {
        "description": "e.g. 'ADR-018'.",
        "title": "Id",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/DecisionStatus"
      },
      "type": {
        "$ref": "#/$defs/DecisionType"
      },
      "depth": {
        "$ref": "#/$defs/Depth"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "context": {
        "title": "Context",
        "type": "string"
      },
      "decision": {
        "title": "Decision",
        "type": "string"
      },
      "alternatives": {
        "items": {
          "type": "string"
        },
        "title": "Alternatives",
        "type": "array"
      },
      "rationale": {
        "title": "Rationale",
        "type": "string"
      },
      "consequences": {
        "items": {
          "type": "string"
        },
        "title": "Consequences",
        "type": "array"
      },
      "evidence_ids": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Ids",
        "type": "array"
      },
      "concept_ids": {
        "items": {
          "type": "string"
        },
        "title": "Concept Ids",
        "type": "array"
      },
      "word_count_target": {
        "default": 250,
        "description": "Suggested NEA word budget for this decision type.",
        "title": "Word Count Target",
        "type": "integer"
      }
    },
    "required": [
      "id",
      "title",
      "status",
      "type",
      "depth",
      "project_id",
      "context",
      "decision",
      "rationale"
    ],
    "title": "Decision",
    "type": "object"
  },
